#!/bin/sh
# Bridge mode: the radio becomes the host's. kestrel-air closes the chip as it
# stops on SIGTERM (its runner does not reboot for that). The stock kernel has
# no FunctionFS: the module comes with fpvOS, next to these hooks.
set -eu
usb=/usrdata/fpv/air/usb
grep -q '^usb_f_fs ' /proc/modules || insmod "$usb/usb_f_fs.ko"
pids=$(pidof kestrel-air || true)
[ -z "$pids" ] || kill -TERM $pids
i=0
while pidof kestrel-air > /dev/null && [ "$i" -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
! pidof kestrel-air > /dev/null || { echo "radio-stop: kestrel-air did not stop" >&2; exit 1; }
